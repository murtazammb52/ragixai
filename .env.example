# ── LLM (Ollama — local, no API key needed) ──────────────────────────────────
# Install Ollama from https://ollama.com, then: ollama pull llama3.2
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ── Embeddings ────────────────────────────────────────────────────────────────
# primary: local sentence-transformers (no key needed)
EMBED_MODEL=local
EMBED_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# Optional: set to "cohere" + add key below to enable Config E
# EMBED_MODEL=cohere
# COHERE_API_KEY=your_cohere_key_here
COHERE_API_KEY=

# ── Pipeline knobs ────────────────────────────────────────────────────────────
CHUNK_STRATEGY=recursive
CHUNK_SIZE=512
CHUNK_OVERLAP=50
TOP_K_RETRIEVE=20
TOP_K_RERANK=5
BM25_WEIGHT=0.4
DENSE_WEIGHT=0.6

# ── Reranker ──────────────────────────────────────────────────────────────────
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ── Storage paths (relative to repo root) ────────────────────────────────────
CHROMA_PERSIST_DIR=data/chroma_db
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8000
DEBUG=false
